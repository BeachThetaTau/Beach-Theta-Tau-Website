{
  "name": "beach-theta-tau-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/functions",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @beach-theta-tau/web",
    "dev:web": "npm run dev --workspace @beach-theta-tau/web",
    "build": "npm run build --workspace @beach-theta-tau/contracts && npm run build --workspace @beach-theta-tau/web && npm run build --workspace @beach-theta-tau/functions",
    "build:web": "npm run build --workspace @beach-theta-tau/contracts && npm run build --workspace @beach-theta-tau/web",
    "build:functions": "npm run build --workspace @beach-theta-tau/functions",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @beach-theta-tau/web",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start",
    "seed:emulator": "tsx scripts/seed-emulator.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
