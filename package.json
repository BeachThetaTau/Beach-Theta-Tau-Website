{
  "name": "beach-theta-tau-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/functions",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @beach-theta-tau/web",
    "dev:web": "npm run dev --workspace @beach-theta-tau/web",
    "build": "npm run build --workspace @beach-theta-tau/contracts && npm run build --workspace @beach-theta-tau/web && npm run build --workspace @beach-theta-tau/functions",
    "build:web": "npm run build --workspace @beach-theta-tau/contracts && npm run build --workspace @beach-theta-tau/web",
    "build:functions": "npm run build --workspace @beach-theta-tau/functions",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "emulators": "firebase emulators:start",
    "optimize:member-photos": "tsx scripts/optimize-member-photos.ts",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "test:functions": "npm run test --workspace @beach-theta-tau/functions",
    "verify": "npm run lint && npm run format:check && npm run typecheck:tools && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
